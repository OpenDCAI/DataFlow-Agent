<mxfile host="DataFlow-MM" agent="dataflow-agentmm" version="1" compressed="false"><diagram id="page1" name="Architecture"><mxGraphModel dx="0" dy="0" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1600" pageHeight="950" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="page1_default" value="Default" parent="0" /><mxCell id="c_triggers" value="INCIDENT TRIGGERS" style="swimlane;horizontal=1;startSize=38;rounded=1;arcSize=12;whiteSpace=wrap;html=1;collapsible=0;fillColor=#ffffff;strokeColor=#91aa9f;fontColor=#203c33;fontFamily=DejaVu Sans;fontSize=16;fontStyle=1;" vertex="1" parent="page1_default"><mxGeometry x="10" y="110" width="340" height="190" as="geometry" /></mxCell><mxCell id="c_roles" value="CORE ROLES &amp; RESPONSIBILITIES" style="swimlane;horizontal=1;startSize=38;rounded=1;arcSize=12;whiteSpace=wrap;html=1;collapsible=0;fillColor=#ffffff;strokeColor=#91aa9f;fontColor=#203c33;fontFamily=DejaVu Sans;fontSize=16;fontStyle=1;" vertex="1" parent="page1_default"><mxGeometry x="10" y="315" width="340" height="275" as="geometry" /></mxCell><mxCell id="c_evidence" value="HANDOFF EVIDENCE CHECKLIST" style="swimlane;horizontal=1;startSize=38;rounded=1;arcSize=12;whiteSpace=wrap;html=1;collapsible=0;fillColor=#ffffff;strokeColor=#91aa9f;fontColor=#203c33;fontFamily=DejaVu Sans;fontSize=16;fontStyle=1;" vertex="1" parent="page1_default"><mxGeometry x="10" y="605" width="340" height="260" as="geometry" /></mxCell><mxCell id="c_branches" value="DECISION &amp; ESCALATION BRANCHES" style="swimlane;horizontal=1;startSize=38;rounded=1;arcSize=12;whiteSpace=wrap;html=1;collapsible=0;fillColor=#ffffff;strokeColor=#91aa9f;fontColor=#203c33;fontFamily=DejaVu Sans;fontSize=16;fontStyle=1;" vertex="1" parent="page1_default"><mxGeometry x="1050" y="110" width="510" height="755" as="geometry" /></mxCell><mxCell id="n_trig1" value="1. Gateway error-budget burn (&gt; 5% / 1h)" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#e5ede9;strokeColor=#73877f;fontColor=#2d423b;fontFamily=DejaVu Sans;fontSize=16;fontStyle=1;" vertex="1" parent="c_triggers"><mxGeometry x="15" y="35" width="310" height="40" as="geometry" /></mxCell><mxCell id="n_trig2" value="2. Payment auth success (&lt; 96% / 5m)" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#e5ede9;strokeColor=#73877f;fontColor=#2d423b;fontFamily=DejaVu Sans;fontSize=16;fontStyle=1;" vertex="1" parent="c_triggers"><mxGeometry x="15" y="80" width="310" height="40" as="geometry" /></mxCell><mxCell id="n_trig3" value="3. Correlated customer reports (3+ regions)" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#e5ede9;strokeColor=#73877f;fontColor=#2d423b;fontFamily=DejaVu Sans;fontSize=16;fontStyle=1;" vertex="1" parent="c_triggers"><mxGeometry x="15" y="125" width="310" height="40" as="geometry" /></mxCell><mxCell id="n_role_ic" value="Incident Commander (IC)&#10;• Owns severity, decisions, and clock" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#d9f3e9;strokeColor=#20956e;fontColor=#12563f;fontFamily=DejaVu Sans;fontSize=16;fontStyle=1;" vertex="1" parent="c_roles"><mxGeometry x="15" y="30" width="310" height="65" as="geometry" /></mxCell><mxCell id="n_role_ops" value="Operations Lead (Ops)&#10;• Runs diagnosis, containment, recovery" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#d9f3e9;strokeColor=#20956e;fontColor=#12563f;fontFamily=DejaVu Sans;fontSize=16;fontStyle=1;" vertex="1" parent="c_roles"><mxGeometry x="15" y="105" width="310" height="65" as="geometry" /></mxCell><mxCell id="n_role_comms" value="Communications Lead (Comms)&#10;• Publishes stakeholder &amp; customer updates" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#d9f3e9;strokeColor=#20956e;fontColor=#12563f;fontFamily=DejaVu Sans;fontSize=16;fontStyle=1;" vertex="1" parent="c_roles"><mxGeometry x="15" y="180" width="310" height="65" as="geometry" /></mxCell><mxCell id="n_ev_rule" value="Evidence Required at Handoff:&#10;• Owner + timestamp&#10;• Metric / customer proof&#10;• Decision + next check" style="shape=note;whiteSpace=wrap;html=1;size=18;fillColor=#e9e4fb;strokeColor=#7764c4;fontColor=#413477;fontFamily=DejaVu Sans;fontSize=16;fontStyle=1;" vertex="1" parent="c_evidence"><mxGeometry x="15" y="30" width="310" height="215" as="geometry" /></mxCell><mxCell id="seq_detect" value="01. DETECT [Ops Lead]&#10;Capture alert, service, region &amp; timestamp" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d9f3e9;strokeColor=#20956e;fontColor=#12563f;fontFamily=DejaVu Sans;fontSize=16;fontStyle=1;" vertex="1" parent="page1_default"><mxGeometry x="480" y="120" width="440" height="70" as="geometry" /></mxCell><mxCell id="seq_validate" value="02. VALIDATE [Ops Lead &amp; IC]&#10;Compare telemetry &amp; customer proof; reject noise" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#d9f3e9;strokeColor=#20956e;fontColor=#12563f;fontFamily=DejaVu Sans;fontSize=16;fontStyle=1;" vertex="1" parent="page1_default"><mxGeometry x="480" y="220" width="440" height="80" as="geometry" /></mxCell><mxCell id="seq_declare" value="03. DECLARE [Incident Commander]&#10;Assign severity (SEV-1 / SEV-2) &amp; core roles" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d9f3e9;strokeColor=#20956e;fontColor=#12563f;fontFamily=DejaVu Sans;fontSize=16;fontStyle=1;" vertex="1" parent="page1_default"><mxGeometry x="480" y="335" width="440" height="75" as="geometry" /></mxCell><mxCell id="seq_contain" value="04. CONTAIN [Operations Lead]&#10;Mitigate impact: Rollback, isolate, rate-limit, fail over" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d9f3e9;strokeColor=#20956e;fontColor=#12563f;fontFamily=DejaVu Sans;fontSize=16;fontStyle=1;" vertex="1" parent="page1_default"><mxGeometry x="480" y="460" width="440" height="75" as="geometry" /></mxCell><mxCell id="seq_recover" value="05. RECOVER [Operations Lead]&#10;Restore service &amp; clear queued work safely" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d9f3e9;strokeColor=#20956e;fontColor=#12563f;fontFamily=DejaVu Sans;fontSize=16;fontStyle=1;" vertex="1" parent="page1_default"><mxGeometry x="480" y="585" width="440" height="70" as="geometry" /></mxCell><mxCell id="seq_verify" value="06. VERIFY [Ops Lead &amp; IC]&#10;Hold key signals inside target for 15 continuous mins" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#fff0c8;strokeColor=#c98712;fontColor=#704b0b;fontFamily=DejaVu Sans;fontSize=16;fontStyle=1;" vertex="1" parent="page1_default"><mxGeometry x="480" y="685" width="440" height="80" as="geometry" /></mxCell><mxCell id="seq_close" value="07. CLOSE [Incident Commander]&#10;Publish summary, owners, and next review time" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d9f5e2;strokeColor=#2d9b5f;fontColor=#175737;fontFamily=DejaVu Sans;fontSize=16;fontStyle=1;" vertex="1" parent="page1_default"><mxGeometry x="480" y="800" width="440" height="65" as="geometry" /></mxCell><mxCell id="br_no_inc" value="Impact Not Confirmed&#10;Close as NO INCIDENT &amp; attach evidence" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#e5ede9;strokeColor=#73877f;fontColor=#2d423b;fontFamily=DejaVu Sans;fontSize=16;fontStyle=1;" vertex="1" parent="c_branches"><mxGeometry x="20" y="115" width="470" height="75" as="geometry" /></mxCell><mxCell id="br_policy" value="Declaration Policy:&#10;Triage all signals; declare when impact confirmed. If uncertain: SEV-2" style="shape=note;whiteSpace=wrap;html=1;size=18;fillColor=#ffffff;strokeColor=#91aa9f;fontColor=#203c33;fontFamily=DejaVu Sans;fontSize=16;fontStyle=1;" vertex="1" parent="c_branches"><mxGeometry x="20" y="210" width="470" height="70" as="geometry" /></mxCell><mxCell id="br_sev1" value="SEV-1 Branch [Comms Lead]&#10;Page executive lead &amp; publish public status update" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#fee2df;strokeColor=#cb5148;fontColor=#762e29;fontFamily=DejaVu Sans;fontSize=16;fontStyle=1;" vertex="1" parent="c_branches"><mxGeometry x="20" y="295" width="470" height="70" as="geometry" /></mxCell><mxCell id="br_sev2" value="SEV-2 Branch [Comms Lead]&#10;Notify internal stakeholders; public update if customer impact visible" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#fff0c8;strokeColor=#c98712;fontColor=#704b0b;fontFamily=DejaVu Sans;fontSize=16;fontStyle=1;" vertex="1" parent="c_branches"><mxGeometry x="20" y="380" width="470" height="70" as="geometry" /></mxCell><mxCell id="br_rollback_fail" value="Rollback Fails [Ops Lead]&#10;Isolate affected region, then fail traffic over" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#fee2df;strokeColor=#cb5148;fontColor=#762e29;fontFamily=DejaVu Sans;fontSize=16;fontStyle=1;" vertex="1" parent="c_branches"><mxGeometry x="20" y="465" width="470" height="75" as="geometry" /></mxCell><mxCell id="br_verify_rule" value="CRITICAL RULE:&#10;Recovery is NOT complete until VERIFY passes for 15 continuous mins!" style="shape=note;whiteSpace=wrap;html=1;size=18;fillColor=#fee2df;strokeColor=#cb5148;fontColor=#762e29;fontFamily=DejaVu Sans;fontSize=16;fontStyle=1;" vertex="1" parent="c_branches"><mxGeometry x="20" y="580" width="470" height="75" as="geometry" /></mxCell><mxCell id="e_trig_detect" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#58756b;" edge="1" parent="page1_default" source="c_triggers" target="seq_detect"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="425" y="205" /><mxPoint x="425" y="155" /></Array></mxGeometry></mxCell><mxCell id="e_det_val" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#58756b;" edge="1" parent="page1_default" source="seq_detect" target="seq_validate"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_val_noinc" value="No Impact" s